{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/nfse.js": {
      "maxDuration": 60
    },
    "api/asaas.js": {
      "maxDuration": 60
    },
    "api/asaas-cron.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/asaas-cron",
      "schedule": "0 10 * * *"
    }
  ]
}
